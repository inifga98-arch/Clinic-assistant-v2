# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (Console > Account info; Sandbox number under Messaging > Try it out > WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The number the agent sends from, e.g. whatsapp:+14155238886 for the Sandbox
TWILIO_WHATSAPP_FROM=

# Public origin Twilio calls (tunnel or Vercel URL), no trailing slash.
# Used to validate Twilio signatures. e.g. https://abc123.ngrok-free.app
PUBLIC_BASE_URL=

# Dev only: skip the Twilio signature check (never set in production)
TWILIO_SKIP_SIGNATURE_CHECK=false

# OpenAI
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_EXTRACT_MODEL=gpt-4.1

# Simulator (optional): who `npm run simulate` talks as when --as is not given, e.g. marina
SIM_AS=

# Patient agent (Person 3)
# Link to the clinic's privacy notice, shown in the welcome message (optional)
PRIVACY_NOTICE_URL=
# Approved Twilio Content Template ids (HX...). Without them, plain text is sent, which
# only arrives inside the patient's 24 h window.
TWILIO_TEMPLATE_WELCOME=
TWILIO_TEMPLATE_REMINDER=
# Shared secret for GET /api/cron/reminders (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
